---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Página no encontrada">
  <section class="flex min-h-screen items-center justify-center px-6 text-center">
    <div>
      <h1 class="mb-2 text-7xl font-black" style="color: #db2777">404</h1>
      <p class="mb-1 text-xl text-white/80">Página no encontrada</p>
      <p class="mb-8 text-white/50">La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="inline-block rounded-lg px-6 py-3 font-semibold text-white transition-colors hover:opacity-90" style="background: #db2777">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
