---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonChatGPT from "../components/buttons/button-chatgpt.astro";
import ButtonSocialMedia from "../components/buttons/button-social-media.astro";
import Card from "../components/buttons/card.astro";
import {
  PaperClip,
  Img,
  Globe,
  Book,
  TextCursor,
  Youtube,
  Twitch,
  Twitter,
  Instagram,
  Discord,
  TikTok,
  Whatsapp,
  Hearts,
  Diamonds,
  Clubs,
  Spades,
} from "../components/icons/index.js";
import backgroundImage from "../assets/background-image.webp";
import profileImage from "../assets/rickyedit-profile.webp";
---

<BaseLayout title="rickyedit">
  <div
    class="fixed inset-0 -z-20 w-full overflow-hidden"
    style="height: 110vh; height: 110svh;"
  >
    <div
      class="absolute inset-0 scale-140 bg-cover bg-center bg-no-repeat opacity-100 blur-sm will-change-transform"
      style={`background-image: url(${backgroundImage.src}); background-attachment: scroll;`}
    >
    </div>
    <div
      class="absolute top-[-10%] left-[-10%] h-150 w-150 animate-pulse rounded-full bg-pink-600/90 blur-[120px]"
    >
    </div>
  </div>

  <section>
    <div
      class="mx-auto h-13 w-[90vw] max-w-100 cursor-pointer rounded-2xl bg-amber-50/30 transition-all duration-300 hover:bg-white/20 sm:h-20 sm:w-100"
    >
      <h1
        class="mt-20 w-full animate-[subtle-in_1.5s_ease-out] text-center font-sans text-4xl font-extrabold text-white sm:text-6xl"
      >
        rickyedit 👓
      </h1>
    </div>
    <Image
      id="header-logo"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      alt="Foto de perfil de rickyedit"
      src={profileImage}
      width={860}
      height={860}
      class="relative top-35 left-1/2 -translate-x-1/2 cursor-pointer rounded-xl transition-all duration-300 hover:scale-105"
    />

    <div
      class="mx-auto mt-70 flex w-[90vw] max-w-[210rem] flex-col rounded-2xl bg-[#565656] p-2 sm:w-[85vw] md:max-w-170 lg:max-w-210"
    >
      <div class="flex max-h-50 flex-col gap-3 overflow-y-auto p-3">
        <div class="flex justify-end">
          <div
            class="max-w-xs rounded-2xl rounded-br-sm bg-pink-600/80 px-4 py-2"
          >
            <span
              class="font-sans text-[10px] text-white md:text-xs lg:text-sm"
            >
              define a rickyedit con una frase:
            </span>
          </div>
        </div>
        <div class="flex justify-start">
          <div
            class="max-w-xs rounded-2xl rounded-bl-sm bg-[#404040] px-4 py-2"
          >
            <span
              class="font-sans text-[10px] text-[#e0e0e0] md:text-xs lg:text-sm"
            >
              "quiéreme o equivócate, a mí me da igual."
            </span>
          </div>
        </div>
      </div>

      <div
        class="flex flex-row items-center gap-2 border-t border-[#6c6c6c] p-2"
      >
        <div class="relative flex-1">
          <input
            type="text"
            placeholder="Escribe un mensaje..."
            class="w-full rounded-3xl border-2 border-[#6c6c6c] bg-transparent px-4 py-2 font-sans text-[10px] text-white outline-none placeholder:text-[#afafaf] focus:border-pink-500/50 md:text-xs lg:text-sm"
            aria-label="Escribe un mensaje"
          />
        </div>
        <button
          class="flex cursor-pointer items-center gap-2 rounded-3xl bg-pink-600 px-4 py-2 text-white transition-colors hover:bg-pink-700"
          aria-label="Enviar"
          title="Enviar"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              d="M3.478 2.404a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.404Z"
            ></path>
          </svg>
        </button>
      </div>

      <div class="flex flex-row flex-wrap justify-center gap-3 p-2">
        <ButtonChatGPT label="Adjuntar" Icon={PaperClip} />
        <ButtonChatGPT label="Buscar" Icon={Globe} />
        <ButtonChatGPT label="Estudiemos" Icon={Book} />
        <ButtonChatGPT label="Crear imagen" Icon={Img} />
      </div>
    </div>
  </section>

  <section>
    <div>
      <h2
        class="mt-20 text-center font-sans text-4xl font-extrabold text-white sm:text-6xl"
      >
        vídeo más reciente
      </h2>
      <div class="flex justify-center">
        <span
          class="text-center font-sans text-[12px] font-extrabold text-white sm:text-xl"
          >se actualiza aproximadamente a la hora de subir el vídeo</span
        >
      </div>
      <div
        class="mx-auto mt-15 aspect-video w-full max-w-4xl overflow-hidden rounded-3xl border border-white/10 shadow-2xl"
      >
        <iframe
          width="100%"
          height="100%"
          src="https://www.youtube.com/embed?listType=user_uploads&list=RickyEdit"
          title="Reproductor de video de YouTube"
          loading="lazy"
          allowfullscreen
          sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
        ></iframe>
      </div>
    </div>
  </section>

  <section
    class="mx-auto mt-30 max-w-4xl rounded-3xl border border-white/10 bg-black p-6 sm:p-10"
  >
    <h2
      class="mb-6 text-center font-sans text-4xl font-extrabold text-white sm:text-6xl"
    >
      sobre rickyedit
    </h2>
    <div class="flex flex-col gap-4 text-center">
      <p class="font-sans text-sm text-white sm:text-lg">
        rickyedit es un streamer y creador de contenido español que publicó por
        primera vez en su canal de YouTube en marzo del 2014, con más de 3.4M de
        suscriptores en YouTube y 1.3M en Twitch.
      </p>
      <p class="font-sans text-sm text-white sm:text-lg">
        su canal empezó con parodias musicales y hoy es conocido por sus
        debates, actualidad y series como "locas de twitter".
      </p>
      <p class="font-sans text-sm text-white sm:text-lg">
        también hace magia, intervenciones en programas de televisión o música
        como "caliente", "blu" y "mi habitación". todo desde Córdoba, España.
      </p>
    </div>
  </section>

  <section id="datos" class="mx-auto mt-30 mb-20 max-w-5xl px-4">
    <h2
      class="mb-15 text-center font-sans text-4xl font-extrabold text-white sm:text-6xl"
    >
      rickyedit en datos
    </h2>
    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4 lg:gap-8">
      <div
        class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-black p-6"
      >
        <span
          class="font-sans text-4xl font-extrabold text-white sm:text-5xl"
          ><span class="counter" data-target="12">0</span></span
        >
        <span class="text-center font-sans text-xs text-white/70 sm:text-sm"
          >años creando contenido</span
        >
      </div>
      <div
        class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-black p-6"
      >
        <span
          class="font-sans text-4xl font-extrabold text-white sm:text-5xl"
          ><span class="counter" data-target="3.6">0</span>M</span
        >
        <span class="text-center font-sans text-xs text-white/70 sm:text-sm"
          >suscriptores en YouTube</span
        >
      </div>
      <div
        class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-black p-6"
      >
        <span
          class="font-sans text-4xl font-extrabold text-white sm:text-5xl"
          ><span class="counter" data-target="1.7">0</span>B</span
        >
        <span class="text-center font-sans text-xs text-white/70 sm:text-sm"
          >visitas en YouTube</span
        >
      </div>
      <div
        class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-black p-6"
      >
        <span
          class="font-sans text-4xl font-extrabold text-white sm:text-5xl"
          ><span class="counter" data-target="1.3">0</span>M</span
        >
        <span class="text-center font-sans text-xs text-white/70 sm:text-sm"
          >seguidores en Twitch</span
        >
      </div>
    </div>
  </section>

  <section>
    <h2
      class="mt-22 text-center font-sans text-4xl font-extrabold text-white sm:text-6xl"
    >
      encuéntrame en...
    </h2>
    <div class="mx-5 mt-10 flex flex-col items-center gap-4 sm:mt-20 sm:flex-row sm:justify-center sm:gap-8 md:mt-40 md:gap-20">
      <ButtonSocialMedia
        label="youtube"
        url="https://www.youtube.com/@rickyedit"
        Icon={Youtube}
      />
      <ButtonSocialMedia
        label="twitch"
        url="https://www.twitch.tv/rickyedit"
        Icon={Twitch}
        color="bg-purple-500"
        text="text-white"
      />
      <ButtonSocialMedia
        label="twitter"
        url="https://twitter.com/rickyedit"
        Icon={Twitter}
        color="bg-[#15202B]"
        text="text-white"
      />
    </div>
    <div class="mx-5 mt-6 flex flex-col items-center gap-4 sm:mt-15 sm:flex-row sm:justify-center sm:gap-8 lg:mx-65 lg:gap-20 xl:mx-100">
      <ButtonSocialMedia
        label="discord"
        url="https://discord.com/invite/rickyedit"
        Icon={Discord}
        color="bg-indigo-500"
        text="text-white"
      />
      <ButtonSocialMedia
        label="instagram"
        url="https://www.instagram.com/rickyedit/"
        Icon={Instagram}
        color="bg-[#FCAF45]"
        text="text-white"
      />
    </div>

    <div class="mx-5 mt-6 flex flex-col items-center gap-4 sm:mt-15 sm:flex-row sm:justify-center sm:gap-8 lg:mx-65 lg:gap-20 xl:mx-100">
      <ButtonSocialMedia
        label="whatsapp"
        url="https://whatsapp.com/channel/0029Va9VWA8IyPtaf9sl183T"
        Icon={Whatsapp}
        color="bg-green-400"
        text="text-white"
      />
      <ButtonSocialMedia
        label="tiktok"
        url="https://www.tiktok.com/@rickyedit"
        Icon={TikTok}
        color="bg-black"
        text="text-white"
      />
    </div>
    <div class="mx-auto mt-20 w-full max-w-5xl px-5">
      <iframe
        data-testid="embed-iframe"
        style="border-radius:12px;"
        src="https://open.spotify.com/embed/track/3SjWj1jkonJqEkwrkCggkV?utm_source=generator"
        width="100%"
        height="352"
        title="Reproductor de música de Spotify"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-presentation allow-popups allow-forms"
      ></iframe>
    </div>
  </section>

  <section>
    <h2
      class="mt-12 text-center font-sans text-4xl font-extrabold text-white sm:mt-22 sm:text-6xl"
    >
      ey no te vayas sin elegir una carta
    </h2>
    <div
      class="relative mx-auto my-auto mt-25 mb-20 flex w-[90vw] max-w-[18rem] flex-row justify-center gap-2 sm:mt-45 sm:max-w-130 lg:max-w-3xl lg:gap-5 xl:max-w-290"
    >
      <Card
        label="fan de locas de twitter (pobre=no puedes opinar, vives en Andorra)"
        Icon={Hearts}
        rotate="-rotate-22"
      />
      <Card
        label="fan de fnaf (técnicamente es withered foxy)"
        Icon={Diamonds}
        rotate="-rotate-10"
      />
      <Card
        label="fan del si te ríes pierdes (mira sus compartidos)"
        Icon={Clubs}
        rotate="rotate-10"
      />
      <Card
        label="fan de los debates (cállate, shush)"
        Icon={Spades}
        rotate="rotate-22"
      />
    </div>
  </section>

</BaseLayout>

<script>
  const counters = document.querySelectorAll<HTMLElement>(".counter");

  if (counters.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseFloat(el.dataset.target ?? "");
            const duration = 1500;
            const start = performance.now();

            function update(now: number) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const current = target * progress;
              el.textContent = (target % 1 === 0 ? Math.floor(current) : current.toFixed(1)).toString();
              if (progress < 1) requestAnimationFrame(update);
            }

            requestAnimationFrame(update);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((c) => observer.observe(c));
  }
</script>
