---
const { Icon, label } = Astro.props;
---

<button
  class="flex cursor-pointer items-center justify-center gap-2 rounded-3xl border-2 border-[#6c6c6c] px-4 py-2 text-white transition-all duration-200 hover:bg-white/10 hover:border-pink-500/50 active:scale-95"
  aria-label={label}
  type="button"
>
  <div class="aspect-square w-3 lg:w-5">
    <Icon class="h-full w-full" />
  </div>
  <span class="font-sans text-[10px] text-white md:text-xs lg:text-sm">
    {label}
  </span>
</button>
