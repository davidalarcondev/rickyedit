---
import "../styles/global.css";
const { title } = Astro.props;
---

<html lang="es" class="min-h-dvh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="rickyedit" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2D1B2D" />
    <meta name="description" content="Sitio no oficial de rickyedit — streamer y creador de contenido español. quiéreme o equivócate, a mí me da igual." />
    <link rel="canonical" href="https://rickyedit.pages.dev/" />
    <meta property="og:title" content="rickyedit (no oficial)" />
    <meta property="og:description" content="Sitio no oficial de rickyedit con enlaces a sus redes sociales, vídeos, y estadísticas." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rickyedit.pages.dev/" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="rickyedit" />
    <meta property="og:image" content="https://rickyedit.pages.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="rickyedit (no oficial)" />
    <meta name="twitter:description" content="Sitio no oficial de rickyedit con enlaces a sus redes sociales, vídeos, y estadísticas." />
    <meta name="twitter:image" content="https://rickyedit.pages.dev/og-image.png" />
    <meta name="twitter:image:alt" content="rickyedit — streamer y creador de contenido" />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "name": "rickyedit",
            "url": "https://rickyedit.pages.dev/",
            "description": "Sitio no oficial de rickyedit. quiéreme o equivócate, a mí me da igual."
          },
          {
            "@type": "Person",
            "name": "rickyedit",
            "url": "https://rickyedit.pages.dev/",
            "sameAs": [
              "https://www.twitch.tv/rickyedit",
              "https://www.youtube.com/@rickyedit",
              "https://twitter.com/rickyedit",
              "https://www.instagram.com/rickyedit/"
            ]
          }
        ]
      }
    </script>
    <link rel="preload" href="/fonts/Onest-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
